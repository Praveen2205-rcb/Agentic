import cohere
import numpy as np
import os
co = cohere.ClientV2(
    api_key=os.environ["COHERE_API_KEY"]
)
embedding_model = os.getenv("COHERE_EMBEDDING_MODEL", "embed-v4.0")
chat_model = os.getenv("COHERE_CHAT_MODEL", "command-a-03-2025")
docs = [
    "EV adoption is growing due to lower running costs.",
    "Major EV challenges include charging infrastructure.",
    "Indian EV market includes two-wheelers and cars.",
    "Tata, Mahindra and Ola are important EV companies."
]
# Embeddings
e = co.embed(
    model=embedding_model,
    texts=docs,
    input_type="search_document",
    embedding_types=["float"]
)
doc_vectors = np.array(e.embeddings.float)
query = "Challenges and opportunities in Indian EV market"
qe = co.embed(
    model=embedding_model,
    texts=[query],
    input_type="search_query",
    embedding_types=["float"]
)
qvec = np.array(qe.embeddings.float[0])
scores = [
    np.dot(qvec,d) /
    (np.linalg.norm(qvec)*np.linalg.norm(d))
    for d in doc_vectors
]
top = np.argsort(scores)[::-1][:3]
context = "\n".join(docs[i] for i in top)
r = co.chat(
    model=chat_model,
    messages=[{
        "role":"user",
        "content":f"""
Create a market research report using:
{context}
"""
    }]
)
print(r.message.content[0].text)

