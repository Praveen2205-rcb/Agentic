import os
from typing import TypedDict
from langgraph.graph import StateGraph, END
from langchain_groq import ChatGroq
llm = ChatGroq(
    model=os.getenv("GROQ_MODEL", "openai/gpt-oss-20b"),
    api_key=os.environ["GROQ_API_KEY"]
)
class State(TypedDict):
    query: str
    category: str
    response: str
def router(state):
    r = llm.invoke(
        f"""
Classify this query as only:
faq, order, complaint.
Query: {state['query']}
"""
    )
    return {"category":r.content.strip().lower()}
def faq(state):
    r = llm.invoke(
        f"Answer this FAQ: {state['query']}"
    )
    return {"response":r.content}
def order(state):
    r = llm.invoke(
        f"Help with this order query: {state['query']}"
    )
    return {"response":r.content}
def complaint(state):
    r = llm.invoke(
        f"Handle this complaint politely: {state['query']}"
    )
    return {"response":r.content}
def route(state):
    return {
        "faq":"faq",
        "order":"order",
        "complaint":"complaint"
    }.get(state["category"],"faq")
g = StateGraph(State)
g.add_node("router", router)
g.add_node("faq", faq)
g.add_node("order", order)
g.add_node("complaint", complaint)
g.set_entry_point("router")
g.add_conditional_edges(
    "router",
    route,
    {
        "faq":"faq",
        "order":"order",
        "complaint":"complaint"
    }
)
g.add_edge("faq", END)
g.add_edge("order", END)
g.add_edge("complaint", END)
app = g.compile()
r = app.invoke({
    "query":"My product arrived damaged",
    "category":"",
    "response":""
})
print(r["response"])

