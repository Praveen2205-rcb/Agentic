from langchain_groq import ChatGroq
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.output_parsers import StrOutputParser
import subprocess
import tempfile
import os
llm = ChatGroq(model=os.getenv("GROQ_MODEL", "openai/gpt-oss-20b"))
generate = ChatPromptTemplate.from_template(
    "Write only Python code for: {task}"
) | llm | StrOutputParser()
fix = ChatPromptTemplate.from_template(
    """Fix this Python code.
Task: {task}
Code:
{code}
Error:
{error}
Return only corrected code."""
) | llm | StrOutputParser()
def run(code):
    f = tempfile.NamedTemporaryFile(
        mode="w", suffix=".py", delete=False
    )
    f.write(code)
    f.close()
    r = subprocess.run(
        ["python", f.name],
        capture_output=True,
        text=True
    )
    return r
task = "Write recursive Python code to calculate factorial of 5."
code = generate.invoke({"task": task}
for i in range(3):
    r = run(code)
    if r.returncode == 0:
        print(code)
        print(r.stdout)
        break
    print("Error:", r.stderr)
    code = fix.invoke({
        "task": task,
        "code": code,
        "error": r.stderr
    })

