from typing import TypedDict
from langgraph.graph import StateGraph, START, END
from langchain_groq import ChatGroq
import os
llm = ChatGroq(model=os.getenv("GROQ_MODEL", "openai/gpt-oss-20b"))
class State(TypedDict):
    question: str
    stock: str
    price: float
    answer: str
def extract(state):
    q = state["question"].upper()
    stock = (
        "AAPL" if "APPLE" in q else
        "TSLA" if "TESLA" in q else
        "MSFT" if "MICROSOFT" in q else
        "UNKNOWN"
    )
    return {"stock": stock}
def price(state):
    prices = {
        "AAPL":195.5,
        "TSLA":180.25,
        "MSFT":420.1
    }
    return {"price":prices.get(state["stock"],0)}
def answer(state):
    r = llm.invoke(
        f"""
Question: {state['question']}
Stock: {state['stock']}
Price: {state['price']}
Give a simple answer.
"""
    )
    return {"answer":r.content}
g = StateGraph(State)
g.add_node("extract", extract)
g.add_node("price", price)
g.add_node("answer", answer)
g.add_edge(START, "extract")
g.add_edge("extract", "price")
g.add_edge("price", "answer")
g.add_edge("answer", END)
bot = g.compile()
r = bot.invoke({
    "question":"What is Microsoft stock price?",
    "stock":"",
    "price":0,
    "answer":""
})
print(r["answer"])

